While loop
# $s0 = pow, $s1 = x
  addi $s0, $0, 1     # pow = 1
  addi $s1, $0, 0     # x = 0

  addi $t0, $0, 128   # t0 = 128 for comparison
while:
  beq $s0, $t0, done    # if pow == 128, exit loop
  sll $s0, $s0, 1       # pow = pow * 2
  addi $s1, $s1, 1      # x = x + 1
  j while               # jump back
done:

For loop
